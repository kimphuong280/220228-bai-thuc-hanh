#include<stdio.h>
int main()
{
  int n,t=0,dao=0;
  printf("nhap day so:");
  scanf("%d",&n);
  while(n>0)
    {
      dao=dao*10 + n%10;
      //%10 la lay chu so cuoi
      //dao*10 la dich so da dao sang trai 1 chu so de them so ms
      // /10 la bo chu so cuoi
      n=n/10;
    }
  printf("day so dao nguoc:%d",dao);
  while(dao>0)
    {
      t=t+dao%10;// lay chu so cuoi cung cua dao + t
      dao=dao/10;// bo chu so cuoi cung de lay so tiep theo
    }
  printf("\n tong:%d",t);
  return 0;
}
